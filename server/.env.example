# Banco (Postgres do Railway)
DATABASE_URL=postgresql://postgres:SENHA@HOST:PORTA/railway
# Use "false" para Postgres local sem SSL
DB_SSL=true
PORT=3000

# Segredo para assinar os logins (use um texto longo e aleatório)
JWT_SECRET=troque-por-um-segredo-longo

# Seu acesso de administrador (criado na primeira vez que o servidor sobe)
ADMIN_EMAIL=voce@seudominio.com
ADMIN_SENHA=troque-esta-senha

# Cria um salão de exemplo quando o banco está vazio (false para não criar)
SEED_EXEMPLO=true

# Chave que o n8n manda no header x-api-key para usar as rotas do agente
N8N_API_KEY=troque-por-uma-senha-longa

# Webhook do n8n que avisa o dono quando a agenda muda (fluxo "Agenda atualizada")
N8N_WEBHOOK_AGENDA=https://SEU-N8N.up.railway.app/webhook/salao-agenda-atualizada
